{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "baygames",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  "vars": {
    // Public site title and iCal calendar name. Override in `.dev.vars` locally.
    "CALENDAR_NAME": "Sports Games"
  },
  "observability": {
    "enabled": true
  }
}
